# my-expense — Apache rewrite rules
# Ogni request che non corrisponde a un file o directory reale
# viene routata al front controller public/index.php.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Lascia passare i file statici reali (JS, CSS, immagini, ecc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tutto il resto va al front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>
