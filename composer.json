{
    "name": "personal/my-expense",
    "description": "Personal expense tracker (local XAMPP)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/class/",
            "App\\Http\\": "src/Http/",
            "App\\Http\\Middleware\\": "src/Http/Middleware/",
            "App\\Controllers\\": "src/Controllers/",
            "App\\Models\\Entities\\": "src/Models/Entities/",
            "App\\Models\\Repositories\\": "src/Models/Repositories/",
            "App\\Services\\": "src/Services/",
            "App\\Validation\\": "src/Validation/",
            "App\\Validation\\Requests\\": "src/Validation/Requests/",
            "App\\Views\\": "src/Views/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:unit": "phpunit --testsuite unit --colors=always",
        "test:integration": "phpunit --testsuite integration --colors=always"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
