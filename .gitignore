# Composer
/vendor/

# Local config (real DB credentials — never commit)
/config/config.php

# Runtime logs
/logs/*
!/logs/.gitkeep

# Allegati utente (file binari, non commit)
/uploads/expenses/
!/uploads/.gitkeep
!/uploads/.htaccess

# Editor / IDE
/.idea/
/.vscode/

# Claude Code (user-local settings)
/.claude/

# OS / OneDrive cruft
Thumbs.db
desktop.ini
.DS_Store

# Local-only files
*.local

# Node / JS test harness
/node_modules/
/package-lock.json

# PHPUnit
/.phpunit.cache/
/.phpunit.result.cache
