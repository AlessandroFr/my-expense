# Il database e i suoi file WAL: dati personali, mai in git
/data/

# Configurazione locale
/config/config.json

# Le chiavi che aprono il database. Contengono solo roba cifrata, ma sono le
# chiavi di casa di chi usa l'app: in git non ci vanno mai.
/config/vault.json

# Log
/logs/*
!/logs/.gitkeep

# Allegati: file dell'utente, non vanno in git
/uploads/expenses/
!/uploads/.gitkeep

# Editor
/.idea/
/.vscode/

# Claude Code (impostazioni locali)
/.claude/

# Scarti di sistema
Thumbs.db
desktop.ini
.DS_Store

# File solo locali
*.local

# Node (il lock va invece in git: fissa le versioni di Electron)
/node_modules/

# Artefatti di build (l'installer prodotto da electron-builder)
/dist/

# End-to-end: il database usa-e-getta e i referti di Playwright
/e2e/.tmp/
/test-results/
/playwright-report/
