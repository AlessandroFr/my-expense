# my-expense — root rewrite
# Apache DocumentRoot e' htdocs/, il front controller vive in public/.
# Inoltra ogni request al sotto-percorso public/ cosi' /my-expense/dashboard
# viene servita da public/index.php senza che l'utente debba digitare /public/.

Options -Indexes

# La PWA ha start_url "./" che risolve come /my-expense/. Senza questa
# direttiva Apache vede la directory reale, non trova un indice valido e
# (con -Indexes attivo) restituisce 403. Con DirectoryIndex public/index.php
# le richieste alla root del progetto vengono servite dal front controller.
DirectoryIndex public/index.php index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Lascia passare solo i FILE reali (le directory devono passare al rewrite
    # qui sotto cosi' che /my-expense/qualcosa/ venga riscritta in public/...).
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Tutto il resto -> public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Blocca accesso diretto a file sensibili al root
<FilesMatch "^(composer\.(json|lock)|\.env.*|\.git.*|\.htaccess|phpunit\.xml|package\.json|package-lock\.json)$">
    Require all denied
</FilesMatch>
